# Required for lead persistence. Use a managed PostgreSQL database in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thinkzone

# Optional transactional email. Configure both values to enable lead notifications.
RESEND_API_KEY=
RESEND_FROM=
LEADS_TO=hello@thinkzone.tech

# Optional AI Lab assistant. Calls may incur API usage charges.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Sanity project for Work and Insights content plus the /studio editor.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# Optional privacy-gated website analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Sentry error monitoring. Use NEXT_PUBLIC_SENTRY_DSN for browser events;
# SENTRY_DSN can be used privately for server and edge runtimes.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
